{
  "name": "mcp-server-web-fetcher",
  "version": "1.0.0",
  "description": "A fast, lightweight MCP server that fetches web pages and converts them into clean Markdown with metadata extraction for LLM analysis",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-scraper",
    "markdown",
    "llm",
    "ai",
    "claude",
    "metadata-extraction"
  ],
  "author": "Your Name",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-web-fetcher": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "cheerio": "^1.0.0",
    "turndown": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/turndown": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/mcp-server-web-fetcher.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/mcp-server-web-fetcher/issues"
  },
  "homepage": "https://github.com/yourusername/mcp-server-web-fetcher#readme"
}
